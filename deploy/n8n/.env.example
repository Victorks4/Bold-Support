# Copie para .env e ajuste os valores.
# No Railway, configure estas variaveis no painel do servico n8n.

# --- Obrigatorias (n8n) ---
# Gere com: openssl rand -hex 32  (ou qualquer string longa e aleatoria)
N8N_ENCRYPTION_KEY=troque-por-uma-chave-longa-e-aleatoria

# Porta (Railway injeta PORT automaticamente - use ${{PORT}} no painel)
N8N_PORT=5678

# Dominio publico (sem barra no final em N8N_HOST)
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/

# CORS: dominios do frontend (Firebase + dev local)
# Separados por virgula, sem espacos
N8N_CORS_ORIGIN=http://localhost:5173

# --- Postgres interno do n8n (metadados: workflows, credenciais) ---
# No Railway: use as variaveis do addon PostgreSQL (${{Postgres.*}})
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=localhost
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=postgres
DB_POSTGRESDB_SCHEMA=public

# --- App Bold Support (opcional nos workflows Etapa 2) ---
WEBHOOK_EXTERNO_URL=https://webhook.site/seu-id-aqui

# --- Seguranca recomendada em producao ---
N8N_SECURE_COOKIE=true
GENERIC_TIMEZONE=America/Sao_Paulo
