      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const clientes = $input.all()\n  .map(item => item.json)\n  .filter(row => row.id);\n\nreturn [{ json: {\n  total: clientes.length,\n  clientes\n} }];"
      },
      "id": "code-formatar-lista",
      "name": "Formatar_lista",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-200",
      "name": "Responde_200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst headers = item.headers ?? {};\nconst auth = headers.authorization ?? headers.Authorization ?? '';\nconst match = /^Bearer\\s+(.+)$/i.exec(auth);\nreturn [{ json: { ...item, token: match ? match[1].trim() : null } }];"
      },
      "id": "get-clientes-extrair-token",
      "name": "Extrair_token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst item = $input.first().json;\nconst token = item.token;\nconst secret = $env.JWT_SECRET;\n\nfunction base64UrlDecode(str) {\n  return Buffer.from(str, 'base64url').toString('utf8');\n}\n\nfunction verifyJwt(token, secret) {\n  if (!token || !secret) return null;\n  const parts = token.split('.');\n  if (parts.length !== 3) return null;\n  const [encodedHeader, encodedPayload, signature] = parts;\n  const expected = crypto\n    .createHmac('sha256', secret)\n    .update(`${encodedHeader}.${encodedPayload}`)\n    .digest('base64url');\n  if (signature !== expected) return null;\n  try {\n    const payload = JSON.parse(base64UrlDecode(encodedPayload));\n    if (payload.exp && Date.now() / 1000 > payload.exp) return null;\n    return payload;\n  } catch {\n    return null;\n  }\n}\n\nconst payload = verifyJwt(token, secret);\nreturn [{ json: { ...item, jwt_valid: !!payload, jwt_payload: payload } }];"
      },
