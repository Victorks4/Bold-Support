    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\nconst { nome, email, telefone } = body;\n\nif (!nome?.trim() || nome.length > 150) {\n  return [{ json: { valid: false, status: 400, erro: 'Nome inválido ou ausente', codigo: 'NOME_INVALIDO' } }];\n}\nif (!email?.trim() || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) {\n  return [{ json: { valid: false, status: 400, erro: 'Email inválido', codigo: 'EMAIL_INVALIDO' } }];\n}\nif (!telefone?.trim()) {\n  return [{ json: { valid: false, status: 400, erro: 'Telefone obrigatório', codigo: 'TELEFONE_OBRIGATORIO' } }];\n}\n\nreturn [{ json: {\n  valid: true,\n  nome: nome.trim(),\n  email: email.trim().toLowerCase(),\n  telefone: telefone.trim()\n} }];"
      },
