    "Inserir_interacao": { "main": [[{ "node": "Atualizar_ticket", "type": "main", "index": 0 }]] },
    "Atualizar_ticket": { "main": [[{ "node": "Webhook_externo", "type": "main", "index": 0 }]] },
    "Webhook_externo": { "main": [[{ "node": "Responde_201", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
