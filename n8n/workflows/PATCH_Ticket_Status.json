    {
      "parameters": {
        "jsCode": "const ticket = $('Atualizar_status').first().json;\nconst anterior = $('Validar_transicao').first().json.status_anterior;\n\nif (!ticket?.id) {\n  return [{ json: {\n    erro: 'Falha ao atualizar status no banco',\n    codigo: 'ERRO_ATUALIZACAO',\n    http_status: 500\n  } }];\n}\n\nreturn [{ json: {\n  ticket_id: ticket.id,\n  mensagem: `Status alterado de ${anterior} para ${ticket.status}.`\n} }];"
      },
