    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst esc = (v) => String(v).replace(/'/g, \"''\");\nconst query = `UPDATE tickets SET status = '${esc(d.novo_status)}', atualizado_em = now() WHERE id = '${d.id}'::uuid RETURNING id, protocolo, cliente_id, titulo, descricao, prioridade, status, criado_em, atualizado_em`;\nreturn [{ json: { query } }];"
      },
