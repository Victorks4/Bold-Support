{
  "name": "DELETE Cliente por ID",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "DELETE",
        "path": "clientes/remover/:id",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-delete-cliente",
      "name": "Webhook_1",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "bold-delete-cliente"
    },
    {
      "parameters": {
        "jsCode": "const params = $input.first().json.params ?? {};\nconst query = $input.first().json.query ?? {};\nconst id = params.id || query.id;\n\nconst uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\n\nif (!id || !uuidRegex.test(id)) {\n  return [{ json: { valid: false, erro: 'ID inválido', codigo: 'ID_INVALIDO' } }];\n}\n\nreturn [{ json: { valid: true, id } }];"
      },
      "id": "code-extrair-id",
      "name": "Extrair_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-id-valido",
      "name": "Id_valido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, nome, email, telefone FROM clientes WHERE id = $1::uuid;",
        "options": {
          "queryReplacement": "={{ $json.id }}"
        }
      },
      "id": "postgres-buscar-cliente",
      "name": "Buscar_cliente",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [660, 200],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nif (!rows.length || !rows[0].id) {\n  return [{ json: { found: false, erro: 'Cliente não encontrado', codigo: 'CLIENTE_NAO_ENCONTRADO' } }];\n}\nreturn [{ json: { found: true, ...rows[0] } }];"
      },
      "id": "code-cliente-existe",
      "name": "Cliente_existe?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 200]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.found }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-encontrado",
      "name": "Encontrado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1100, 200]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*)::int AS total FROM tickets WHERE cliente_id = $1::uuid;",
        "options": {
          "queryReplacement": "={{ $json.id }}"
        }
      },
      "id": "postgres-contar-tickets",
      "name": "Contar_tickets",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1320, 100]
    },
    {
      "parameters": {
        "jsCode": "const total = Number($input.first().json.total ?? 0);\nconst cliente = $('Cliente_existe?').first().json;\n\nif (total > 0) {\n  return [{ json: {\n    pode_excluir: false,\n    erro: 'Não é possível excluir cliente com tickets vinculados',\n    codigo: 'CLIENTE_POSSUI_TICKETS'\n  } }];\n}\n\nreturn [{ json: { pode_excluir: true, id: cliente.id, nome: cliente.nome } }];"
      },
      "id": "code-verificar-tickets",
      "name": "Pode_excluir?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 100]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.pode_excluir }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-pode-excluir",
      "name": "Sem_tickets?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1760, 100]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "DELETE FROM clientes WHERE id = $1::uuid RETURNING id, nome, email, telefone;",
        "options": {
          "queryReplacement": "={{ $json.id }}"
        }
      },
