        "jsCode": "const rows = $input.all().map(i => i.json);\nif (!rows.length || !rows[0].id) {\n  return [{ json: { found: false, erro: 'Cliente não encontrado', codigo: 'CLIENTE_NAO_ENCONTRADO' } }];\n}\nreturn [{ json: { found: true, ...rows[0] } }];"
      },
