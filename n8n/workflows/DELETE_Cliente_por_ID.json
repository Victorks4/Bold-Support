      "parameters": {
        "jsCode": "const total = Number($input.first().json.total ?? 0);\nconst cliente = $('Cliente_existe?').first().json;\n\nif (total > 0) {\n  return [{ json: {\n    pode_excluir: false,\n    erro: 'Não é possível excluir cliente com tickets vinculados',\n    codigo: 'CLIENTE_POSSUI_TICKETS'\n  } }];\n}\n\nreturn [{ json: { pode_excluir: true, id: cliente.id, nome: cliente.nome } }];"
      },
