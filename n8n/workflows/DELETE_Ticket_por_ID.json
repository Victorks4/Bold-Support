{
  "name": "DELETE Ticket por ID",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "DELETE",
        "path": "tickets/remover/:id",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-delete-ticket",
      "name": "Webhook_1",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "bold-delete-ticket"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst id = item.params?.id || item.query?.id;\n\nconst uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\n\nif (!id || !uuidRegex.test(id)) {\n  return [{ json: { valid: false, erro: 'ID do ticket inválido', codigo: 'ID_INVALIDO' } }];\n}\n\nreturn [{ json: { valid: true, id } }];"
      },
      "id": "code-extrair-id",
      "name": "Extrair_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-id-valido",
      "name": "Id_valido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, protocolo, status FROM tickets WHERE id = $1::uuid;",
        "options": {
          "queryReplacement": "={{ $json.id }}"
        }
      },
      "id": "postgres-buscar-ticket",
      "name": "Buscar_ticket",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [660, 200],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const ticket = $input.first().json;\n\nif (!ticket?.id) {\n  return [{ json: { found: false, erro: 'Ticket não encontrado', codigo: 'TICKET_NAO_ENCONTRADO' } }];\n}\n\nreturn [{ json: { found: true, ...ticket } }];"
      },
      "id": "code-ticket-existe",
      "name": "Ticket_existe?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 200]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.found }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-encontrado",
      "name": "Encontrado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1100, 200]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "DELETE FROM tickets WHERE id = $1::uuid RETURNING id, protocolo, status;",
        "options": {
          "queryReplacement": "={{ $json.id }}"
        }
      },
      "id": "postgres-excluir-ticket",
      "name": "Excluir_ticket",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1320, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WEBHOOK_EXTERNO_URL || 'https://webhook.site/placeholder-bold-support' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { protocolo: $json.protocolo, evento: 'ticket_excluido', status: $json.status } }}",
        "options": {}
      },
      "id": "http-webhook-externo",
      "name": "Webhook_externo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 100],
      "continueOnFail": true
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { mensagem: 'Ticket removido com sucesso', ticket: $('Excluir_ticket').first().json } }}",
        "options": { "responseCode": 200 }
      },
      "id": "respond-200",
      "name": "Responde_200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1760, 100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { erro: $json.erro, codigo: $json.codigo } }}",
        "options": { "responseCode": 404 }
      },
      "id": "respond-404",
      "name": "Responde_404",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1320, 320]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { erro: $json.erro, codigo: $json.codigo } }}",
        "options": { "responseCode": 400 }
      },
      "id": "respond-400",
      "name": "Responde_400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, 420]
    }
  ],
  "connections": {
    "Webhook_1": { "main": [[{ "node": "Extrair_id", "type": "main", "index": 0 }]] },
    "Extrair_id": { "main": [[{ "node": "Id_valido?", "type": "main", "index": 0 }]] },
    "Id_valido?": {
      "main": [
        [{ "node": "Buscar_ticket", "type": "main", "index": 0 }],
        [{ "node": "Responde_400", "type": "main", "index": 0 }]
      ]
    },
    "Buscar_ticket": { "main": [[{ "node": "Ticket_existe?", "type": "main", "index": 0 }]] },
    "Ticket_existe?": { "main": [[{ "node": "Encontrado?", "type": "main", "index": 0 }]] },
    "Encontrado?": {
      "main": [
        [{ "node": "Excluir_ticket", "type": "main", "index": 0 }],
        [{ "node": "Responde_404", "type": "main", "index": 0 }]
      ]
    },
    "Excluir_ticket": { "main": [[{ "node": "Webhook_externo", "type": "main", "index": 0 }]] },
    "Webhook_externo": { "main": [[{ "node": "Responde_200", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
