        }
      },
      "id": "postgres-buscar-agente",
      "name": "Buscar_agente",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [660, 200],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const row = $input.first().json;\nif (!row?.id) {\n  return [{ json: { found: false } }];\n}\nreturn [{ json: { found: true, id: row.id, nome: row.nome, email: row.email } }];"
      },
      "id": "code-agente-encontrado",
