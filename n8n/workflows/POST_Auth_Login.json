      "id": "if-agente-found",
      "name": "Credenciais_validas?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1100, 200]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst agente = $input.first().json;\nconst secret = $env.JWT_SECRET;\nconst expiresIn = Number($env.JWT_EXPIRES_IN || 3600);\nconst now = Math.floor(Date.now() / 1000);\n\nfunction base64UrlEncode(input) {\n  const buffer = Buffer.isBuffer(input) ? input : Buffer.from(input, 'utf8');\n  return buffer.toString('base64url');\n}\n\nfunction signJwt(payload, secret) {\n  const header = { alg: 'HS256', typ: 'JWT' };\n  const encodedHeader = base64UrlEncode(JSON.stringify(header));\n  const encodedPayload = base64UrlEncode(JSON.stringify(payload));\n  const signature = crypto\n    .createHmac('sha256', secret)\n    .update(`${encodedHeader}.${encodedPayload}`)\n    .digest('base64url');\n  return `${encodedHeader}.${encodedPayload}.${signature}`;\n}\n\nif (!secret) {\n  throw new Error('JWT_SECRET não configurado no n8n');\n}\n\nconst token = signJwt(\n  { sub: agente.id, email: agente.email, nome: agente.nome, exp: now + expiresIn },\n  secret\n);\n\nreturn [{\n  json: {\n    access_token: token,\n    expires_in: expiresIn,\n    agente: { id: agente.id, nome: agente.nome, email: agente.email }\n  }\n}];"
      },
      "id": "code-gerar-jwt",
      "name": "Gerar_JWT",
