    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\nconst email = body.email?.trim().toLowerCase();\nconst senha = body.senha ?? body.password ?? '';\n\nif (!email || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) {\n  return [{ json: { valid: false, status: 400, erro: 'Email inválido', codigo: 'EMAIL_INVALIDO' } }];\n}\nif (!senha || !String(senha).trim()) {\n  return [{ json: { valid: false, status: 400, erro: 'Senha obrigatória', codigo: 'SENHA_OBRIGATORIA' } }];\n}\n\nreturn [{ json: { valid: true, email, senha: String(senha) } }];"
      },
      "id": "code-validar-login",
      "name": "Validar_payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300]
