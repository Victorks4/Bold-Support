# Base URL dos webhooks n8n (dev: proxy Vite /webhook → dev.boldsolution.com.br)
VITE_N8N_WEBHOOK_BASE_URL=/webhook

# Token do webhook.site (UUID da sua URL) — sincroniza /eventos com o que chega no webhook.site
# Ex.: URL https://webhook.site/abc-123-def → token = abc-123-def
# VITE_WEBHOOK_SITE_TOKEN=seu-token-aqui

# Proxy interno para API do webhook.site (não alterar em dev)
# VITE_WEBHOOK_SITE_PROXY=/webhook-site-api
