VITE_WEBHOOK_ID_DELETE_CLIENTE=bold-delete-cliente
VITE_WEBHOOK_ID_POST_TICKETS=bold-post-tickets
VITE_WEBHOOK_ID_GET_TICKETS=bold-get-tickets
VITE_WEBHOOK_ID_GET_TICKET=bold-get-ticket-id
VITE_WEBHOOK_ID_DELETE_TICKET=bold-delete-ticket
VITE_WEBHOOK_ID_PATCH_STATUS=bold-patch-ticket-status
VITE_WEBHOOK_ID_POST_INTERACAO=bold-post-ticket-interacao
