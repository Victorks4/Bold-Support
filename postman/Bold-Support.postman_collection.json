{

  "info": {

    "_postman_id": "bold-support-collection",

    "name": "Bold Support — Etapa 3",

    "description": "Rotas da API Bold Support (produção n8n Bold Solution).\n\n**Pré-requisito:** workflows importados e **ativos** na instância.\n\n**Environment:** `base_url` = `https://dev.boldsolution.com.br/webhook`\n\nUse a Production URL exibida no node Webhook_1 de cada workflow.",

    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"

  },

  "item": [

    {

      "name": "GET — Listar clientes",

      "request": {

        "method": "GET",

        "header": [],

        "url": "{{base_url}}/clientes",

        "description": "Workflow: `GET_Clientes.json`"

      }

    },

    {

      "name": "GET — Cliente por ID",

      "request": {

        "method": "GET",

        "header": [],

        "url": "{{base_url}}/clientes/id/{{cliente_id}}",

        "description": "Workflow: `GET_Cliente_por_ID.json`"

      }

    },

    {

      "name": "GET — Listar tickets",

      "request": {

        "method": "GET",

        "header": [],

        "url": "{{base_url}}/tickets/listar?status=aberto",

        "description": "Workflow: `GET_Tickets.json` — informe `status` ou `prioridade` na query."

      }

    },

    {

      "name": "GET — Ticket por ID",

      "request": {

        "method": "GET",

        "header": [],

        "url": "{{base_url}}/tickets/id/{{ticket_id}}",

        "description": "Workflow: `GET_Ticket_por_ID.json` — retorna ticket com interações."

      }

    },

    {

      "name": "PATCH — Atualizar status do ticket",

      "request": {

        "method": "PATCH",

        "header": [{ "key": "Content-Type", "value": "application/json" }],

        "body": {

          "mode": "raw",

          "raw": "{\n  \"status\": \"em_atendimento\"\n}",

          "options": { "raw": { "language": "json" } }

        },

        "url": "{{base_url}}/tickets/atualizar-status/{{ticket_id}}",

        "description": "Workflow: `PATCH_Ticket_Status.json`"

      }

    },

    {

      "name": "POST — Adicionar interação ao ticket",

      "request": {

        "method": "POST",

        "header": [{ "key": "Content-Type", "value": "application/json" }],

        "body": {

          "mode": "raw",

          "raw": "{\n  \"tipo\": \"cliente\",\n  \"mensagem\": \"Enviei o comprovante por e-mail para análise.\"\n}",

          "options": { "raw": { "language": "json" } }

        },

        "url": "{{base_url}}/tickets/adicionar-interacao/{{ticket_id}}",

        "description": "Workflow: `POST_Ticket_Interacao.json`"

      }

    },

    {

      "name": "DELETE — Remover ticket",

      "request": {

        "method": "DELETE",

        "header": [],

        "url": "{{base_url}}/tickets/remover/{{ticket_id}}",

        "description": "Workflow: `DELETE_Ticket_por_ID.json`"

      }

    },

    {

      "name": "DELETE — Remover cliente",

      "request": {

        "method": "DELETE",

        "header": [],

        "url": "{{base_url}}/clientes/remover/{{cliente_id}}",

        "description": "Workflow: `DELETE_Cliente_por_ID.json` — só funciona sem tickets vinculados."

      }

    }

  ]

}

