    {
      "name": "DELETE - Remover cliente",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 ou 409', function () {",
              "    pm.expect([200, 409]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    pm.test('Cliente removido', function () {",
              "        const json = pm.response.json();",
              "        pm.expect(json).to.have.property('mensagem');",
              "        pm.expect(json).to.have.property('cliente');",
              "    });",
              "}",
              "",
              "if (pm.response.code === 409) {",
              "    pm.test('Conflito — cliente com tickets', function () {",
              "        const json = pm.response.json();",
              "        pm.expect(json.codigo).to.eql('CLIENTE_POSSUI_TICKETS');",
              "    });",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "https://dev.boldsolution.com.br/webhook/bold-delete-cliente/clientes/remover/18695f4c-43be-4646-83dd-98c55ca9c90f",
          "protocol": "https",
          "host": [
