# Importacao de workflows no n8n (Railway)
# Uso: cp .env.railway.example .env.railway

N8N_BASE_URL=https://your-service.up.railway.app
N8N_API_KEY=

# Credencial Postgres no n8n (opcional - o import tenta preservar a ja configurada)
N8N_POSTGRES_CREDENTIAL_NAME=Bold Support - Postgres
# ID da credencial (n8n -> Credentials -> Postgres -> copie o id da URL). Use se a API retornar 405 em /credentials
# N8N_POSTGRES_CREDENTIAL_ID=

# Webhook externo - configure tambem no Railway (WEBHOOK_EXTERNO_URL) e nos workflows
WEBHOOK_EXTERNO_URL=https://webhook.site/seu-id-aqui
