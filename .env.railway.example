# Importacao de workflows no n8n (Railway)
# Uso: cp .env.railway.example .env.railway

N8N_BASE_URL=https://bold-support-production.up.railway.app
N8N_API_KEY=cole-sua-api-key-aqui

# Credencial Postgres Supabase (opcional — o import tenta preservar a ja configurada)
N8N_POSTGRES_CREDENTIAL_NAME=Bold Support - Supabase
# ID da credencial (n8n → Credentials → Postgres → copie o id da URL). Use se a API retornar 405 em /credentials
# N8N_POSTGRES_CREDENTIAL_ID=

# Webhook externo (webhook.site) — tambem configure no Railway se usar $env nos workflows
WEBHOOK_EXTERNO_URL=https://webhook.site/11a466f4-4072-4933-9a03-6d01af6fde27
